# Copy this file to .env (never commit .env) and fill in from
# Supabase Dashboard -> Project Settings -> API.
# Only the public "anon" key belongs here. NEVER use the service_role key in this project.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
